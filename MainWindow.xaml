<Window x:Class="CoiDataExtractor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Captain of Industry - Extracteur de Prototypes JSON" Height="650" Width="1050"
        WindowStartupLocation="CenterScreen" Background="#F4F4F6">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barre d'actions supérieure -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="📁 Choisir un dossier..." Padding="12,7" Click="BtnBrowse_Click"
                        FontWeight="SemiBold" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"/>

                <TextBox x:Name="TxtFolderPath" Grid.Column="1" Margin="10,0" VerticalContentAlignment="Center"
                         IsReadOnly="True" Foreground="#555" Background="#F9F9F9" Padding="8,4" BorderBrush="#CCC"/>

                <Button x:Name="BtnSaveJson" Grid.Column="2" Content="💾 Enregistrer sous (JSON)..." Padding="14,7"
                        Click="BtnSaveJson_Click" FontWeight="SemiBold" Background="#28A745" Foreground="White" 
                        BorderThickness="0" Cursor="Hand" IsEnabled="False"/>
            </Grid>
        </Border>

        <!-- Visualisation des données (3 Onglets) -->
        <TabControl Grid.Row="1" Background="White" BorderBrush="#E0E0E0">
            <!-- Onglet 1 : Produits -->
            <TabItem Header=" 📦 Produits " FontWeight="SemiBold">
                <DataGrid x:Name="DgProducts" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          Background="White" RowHeaderWidth="0" Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Identifiant (ID)" Binding="{Binding Id}" Width="200"/>
                        <DataGridTextColumn Header="Nom du Produit" Binding="{Binding Name}" Width="200"/>
                        <DataGridTextColumn Header="Type de Convoyeur" Binding="{Binding TransportType}" Width="160"/>
                        <DataGridTextColumn Header="Chemin Icône" Binding="{Binding IconPath}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Onglet 2 : Machines -->
            <TabItem Header=" 🏭 Machines " FontWeight="SemiBold">
                <DataGrid x:Name="DgMachines" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          Background="White" RowHeaderWidth="0" Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="150"/>
                        <DataGridTextColumn Header="Identifiant (ID)" Binding="{Binding Id}" Width="180"/>
                        <DataGridTextColumn Header="Tier Suivant" Binding="{Binding NextTierId}" Width="180"/>
                        <DataGridTextColumn Header="Icône / Prefab" Binding="{Binding IconOrPrefab}" Width="250"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Onglet 3 : Recettes -->
            <TabItem Header=" ⚙️ Recettes " FontWeight="SemiBold">
                <DataGrid x:Name="DgRecipes" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          Background="White" RowHeaderWidth="0" Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Recette ID" Binding="{Binding RecipeId}" Width="220"/>
                        <DataGridTextColumn Header="Ingrédients (Inputs)" Binding="{Binding InputsDisplay}" Width="250"/>
                        <DataGridTextColumn Header="Produits (Outputs)" Binding="{Binding OutputsDisplay}" Width="220"/>
                        <DataGridTextColumn Header="Machines &amp; Durée" Binding="{Binding BindingsDisplay}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- Barre de statut inférieure -->
        <StatusBar Grid.Row="2" Background="Transparent" Margin="0,8,0,0">
            <TextBlock x:Name="LblStatus" Text="Veuillez sélectionner un dossier contenant les fichiers sources .cs..." Foreground="#666"/>
        </StatusBar>
    </Grid>
</Window>