<Window x:Class="CoiDataExtractor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CoiDataExtractor"
        Title="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=WindowTitle}" 
        Height="680" Width="1160"
        WindowStartupLocation="CenterScreen" Background="#F4F4F6">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barre d'actions supérieure -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=BtnBrowse}" 
                Padding="12,7" Click="BtnBrowse_Click"
                FontWeight="SemiBold" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"/>

                <TextBox x:Name="TxtFolderPath" Grid.Column="1" Margin="10,0" VerticalContentAlignment="Center"
                 IsReadOnly="True" Foreground="#555" Background="#F9F9F9" Padding="8,4" BorderBrush="#CCC"/>

                <!-- Champ Version du jeu -->
                <TextBlock Grid.Column="2" 
                   Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=LblGameVersion}" 
                   VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#444" FontWeight="SemiBold"/>

                <TextBox x:Name="TxtGameVersion" Grid.Column="3" Width="85" Text="0.8.7D"
                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                 Padding="6,4" Margin="0,0,10,0" BorderBrush="#CCC"/>

                <Button x:Name="BtnSaveJson" Grid.Column="4" 
                Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=BtnSaveJson}" 
                Padding="14,7" Click="BtnSaveJson_Click" FontWeight="SemiBold" Background="#28A745" Foreground="White" 
                BorderThickness="0" Cursor="Hand" IsEnabled="False" Margin="0,0,10,0"/>

                <!-- Sélecteur de langue -->
                <ComboBox x:Name="CmbLanguage" Grid.Column="5" Width="105" VerticalContentAlignment="Center"
                  SelectionChanged="CmbLanguage_SelectionChanged" SelectedIndex="0" Padding="6,4">
                    <ComboBoxItem Content="🇬🇧 English" Tag="en"/>
                    <ComboBoxItem Content="🇫🇷 Français" Tag="fr"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- Visualisation des données (3 Onglets) -->
        <TabControl Grid.Row="1" Background="White" BorderBrush="#E0E0E0">
            <!-- Onglet 1 : Produits -->
            <TabItem Header="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=TabProducts}" FontWeight="SemiBold">
                <DataGrid x:Name="DgProducts" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          Background="White" RowHeaderWidth="0" Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=ColProductId}" Binding="{Binding Id}" Width="180"/>
                        <DataGridTextColumn Header="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=ColProductName}" Binding="{Binding Name}" Width="190"/>
                        <DataGridTextColumn Header="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=ColTransportType}" Binding="{Binding TransportType}" Width="140"/>

                        <DataGridTemplateColumn Header="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=ColColor}" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Color}" VerticalAlignment="Center" Margin="5,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#222"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFallbackColor}" Value="True">
                                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="ToolTip" Value="Color from resources.json"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=ColIconPath}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IconPath}" VerticalAlignment="Center" Margin="5,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#222"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFallbackIcon}" Value="True">
                                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="ToolTip" Value="Default generated icon path"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Onglet 2 : Machines -->
            <TabItem Header="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=TabMachines}" FontWeight="SemiBold">
                <DataGrid x:Name="DgMachines" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          Background="White" RowHeaderWidth="0" Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=ColMachineName}" Binding="{Binding Name}" Width="160"/>
                        <DataGridTextColumn Header="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=ColMachineId}" Binding="{Binding Id}" Width="190"/>
                        <DataGridTextColumn Header="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=ColNextTier}" Binding="{Binding NextTierId}" Width="190"/>
                        <DataGridTextColumn Header="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=ColIconPrefab}" Binding="{Binding IconOrPrefab}" Width="260"/>
                        <DataGridTextColumn Header="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=ColDescription}" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Onglet 3 : Recettes -->
            <TabItem Header="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=TabRecipes}" FontWeight="SemiBold">
                <DataGrid x:Name="DgRecipes" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          Background="White" RowHeaderWidth="0" Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=ColSourceFile}" Binding="{Binding SourceFile}" Width="160"/>
                        <DataGridTextColumn Header="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=ColRecipeId}" Binding="{Binding RecipeId}" Width="230"/>
                        <DataGridTextColumn Header="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=ColInputs}" Binding="{Binding InputsDisplay}" Width="260"/>
                        <DataGridTextColumn Header="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=ColOutputs}" Binding="{Binding OutputsDisplay}" Width="240"/>
                        <DataGridTextColumn Header="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=ColMachineDuration}" Binding="{Binding BindingsDisplay}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- Barre de statut inférieure avec version à droite -->
        <StatusBar Grid.Row="2" Background="Transparent" Margin="0,8,0,0">
            <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StatusBar}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Message de statut à gauche -->
                <TextBlock Grid.Column="0" x:Name="LblStatus" 
                           Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=StatusReady}" 
                           Foreground="#666" VerticalAlignment="Center"/>

                <!-- Numéro de version en bas à droite -->
                <TextBlock Grid.Column="1" Text="v1.0" 
                           Foreground="#888" FontWeight="SemiBold" 
                           Margin="0,0,15,0" VerticalAlignment="Center"/>
            </Grid>
        </StatusBar>
        
    </Grid>
    
</Window>